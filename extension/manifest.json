{
  "manifest_version": 3,
  "name": "FoxLoader",
  "version": "1.2",
  "description": "Smart download interception, video & media sniffing, batch link grabber, and desktop integration for FoxLoader.",
  "permissions": [
    "downloads",
    "notifications",
    "contextMenus",
    "tabs",
    "storage",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ermiya-downloader@ermiya.com",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["sniffer.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "FoxLoader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
